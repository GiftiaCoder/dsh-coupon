{
  "name": "dsh-coupon",
  "version": "0.6.4",
  "description": "给 DSH agent 的票夹：markdown 模板 + 单账户 + md5 自校验核销 + Web 面板 + 签发/作废通知。",
  "license": "MIT",
  "author": "GiftiaCoder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GiftiaCoder/dsh-coupon.git"
  },
  "bugs": {
    "url": "https://github.com/GiftiaCoder/dsh-coupon/issues"
  },
  "homepage": "https://github.com/GiftiaCoder/dsh-coupon#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "coupon",
    "wallet",
    "agent"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "routes.mjs",
    "notify.mjs",
    "store.js",
    "hostdeps.mjs",
    "client.js",
    "cordis.patch.yml",
    "assets/",
    "defaults/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
